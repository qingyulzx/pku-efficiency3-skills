{
  "profile": "default",
  "description": "Neutral academic style. Use when the case names no target journal/template.",
  "source_urls": [],
  "figure": { "width_mm": 120, "height_mm": 80 },
  "margins": { "left": 0.16, "bottom": 0.15, "right": 0.04, "top": 0.10 },
  "font": {
    "family": "DejaVu Sans",
    "fallbacks": ["Arial", "Helvetica", "SimHei", "Microsoft YaHei", "Noto Sans CJK SC"],
    "tick_pt": 8, "label_pt": 9, "title_pt": 10, "marker_pt": 4, "error_cap_pt": 2.0
  },
  "lines": {
    "axis_linewidth_pt": 0.8, "data_linewidth_pt": 1.0,
    "bar_edge_linewidth_pt": 0.5, "error_linewidth_pt": 0.7, "pie_edge_pt": 0.5
  },
  "colors": {
    "palette": ["#0072b2", "#d55e00", "#009e73", "#cc79a7", "#e69f00", "#56b4e9", "#f0e442", "#000000"],
    "note": "Okabe-Ito colour-blind-safe palette as published by the Nature research figure guide"
  },
  "bar": { "edge_color": "black", "error_color": "black" },
  "heatmap": { "colormap": "viridis" },
  "spines": { "show_top_right": false },
  "legend": { "loc": "best" },
  "export": { "formats": ["svg", "pdf", "png"], "png_dpi": 300, "color_mode": "RGB" }
}
